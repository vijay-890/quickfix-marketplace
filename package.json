{
  "name": "quickfix-marketplace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "seed": "npm run seed -w backend",
    "setup:vapid": "npm run setup:vapid -w backend",
    "format": "prettier --write \"backend/**/*.{js,mjs}\" \"frontend/src/**/*.{js,jsx,css}\" \"frontend/vite.config.js\" \"render.yaml\"",
    "format:check": "prettier --check \"backend/**/*.{js,mjs}\" \"frontend/src/**/*.{js,jsx,css}\" \"frontend/vite.config.js\" \"render.yaml\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "3.9.10",
    "rollup": "npm:@rollup/wasm-node@4.63.5"
  },
  "engines": {
    "node": ">=20"
  }
}
